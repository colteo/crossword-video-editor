{
  "template_type": "template_type-a",
  "fonts": {
    "main": {
      "file": "PressStart2P-Regular.ttf",
      "settings": {
        "clue": {
          "size": 28,
          "color": [0, 0, 0]
        },
        "grid": {
          "size": 46,
          "color": [0, 0, 0],
          "vertical_adjustment": 4,
          "horizontal_adjustment": 2
        }
      }
    },
    "fallback": "Arial"
  },
  "animation_sequence": [
    {
      "type": "initial_grid",
      "start": 0.5,
      "end": 3.6
    },
    {
      "type": "word_reveal",
      "sequence": [
        {
          "word_index": 0,
          "animations": [
            {
              "type": "show_grid_empty",
              "start": 3.6,
              "end": 10.8
            },
            {
              "type": "show_clue",
              "start": 3.6,
              "end": 9.1,
              "pos_x": 410,
              "pos_y": 1380,
              "max_text_width": 495,
              "text_color": [0, 0, 0],
              "text_align": "center"
            },
            {
              "type": "show_grid_word",
              "start": 10.8,
              "end": 14.8,
              "letter_animation": {
                "type": "sequential",
                "time_percentage": 10
              }
            }
          ]
        },
        {
          "word_index": 1,
          "animations": [
            {
              "type": "show_grid_empty",
              "start": 14.8,
              "end": 22.0
            },
            {
              "type": "show_clue",
              "start": 14.8,
              "end": 20.3,
              "pos_x": 410,
              "pos_y": 1380,
              "max_text_width": 495,
              "text_color": [0, 0, 0],
              "text_align": "center"
            },
            {
              "type": "show_grid_word",
              "start": 22.0,
              "end": 26.0,
              "letter_animation": {
                "type": "instant"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "random_phrases",
      "settings": {
        "highlight_words": {
          "follow": [255, 0, 0],
          "subscribe": [0, 128, 0],
          "share": [0, 0, 255]
        },
        "phrases_to_show": [
          {
            "type": "social",
            "start": 3.6,
            "end": 6.6,
            "pos_x": "center",
            "pos_y": 100,
            "max_text_width": 800,
            "text_color": [0, 0, 0],
            "text_align": "center",
            "text_transform": "uppercase"
          },
          {
            "type": "joke",
            "start": 6.6,
            "end": 9.6,
            "pos_x": "center",
            "pos_y": 100,
            "max_text_width": 800,
            "text_color": [0, 0, 0],
            "text_align": "center",
            "text_transform": "uppercase"
          }
        ]
      }
    }
  ],
  "style_settings": {
    "crossword": {
      "cell_size": 75,
      "border_color": [0, 0, 0],
      "background_color": [255, 255, 255],
      "highlight_color": [0, 255, 0],
      "text_color": [0, 0, 0]
    }
  },
  "layout": {
    "clue_distance_from_bottom": 100,
    "crossword_position": "center"
  }
